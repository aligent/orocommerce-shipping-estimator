{% block _shipping_estimator_container_widget %}
    {% import '@OroUI/layouts/renderIcon.html.twig' as renderIcon %}

    {% set attr = layout_attr_defaults(attr, {
        'data-page-component-module': 'aligentshippingestimator/js/app/components/shipping-estimator-view-component',
        'data-page-component-options': {
            'view': 'oroui/js/app/views/layout-subtree-view'
        },
        '~class': ' shopping_list__shipping-estimator'
    }) %}

    {% set collapseId = 'shipping-estimator-'|uniqid %}

    <div {{ block('block_attributes') }}>
        <button class="shipping-estimator__title collapse-toggle"
                type="button"
                data-toggle="collapse"
                data-target="{{ '#' ~ collapseId }}"
                aria-controls="{{ collapseId }}"
                aria-expanded="false"
        >
            <span data-icon class="trigger-icon">{{ renderIcon.icon({name: 'chevron-right'}) }}</span>
            <span data-text>{{ 'aligent.shipping.estimator.title'|trans }}</span>
        </button>
        <div id="{{ collapseId }}"
             class="collapse"
             data-trigger-icon-show="chevron-up"
             data-trigger-icon-hide="chevron-right"
        >
            <p>{{ 'aligent.shipping.estimator.note'|trans({'%contactUsUrl%': path('oro_contactus_bridge_contact_us_page')})|raw }}</p>
            {{ block_widget(block) }}
            <div class="shopping_list__shipping-estimate" data-js="shipping-estimate-output"></div>
        </div>
    </div>
{% endblock %}
